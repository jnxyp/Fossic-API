# Docker 内连宿主机 MySQL 用 host.docker.internal，连远程直接填 IP/域名
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DEBUG=False
MOD_CACHE_TIME=300
# Local: provision ./data first. Compose overrides this with /data/download-stats.sqlite3.
DOWNLOAD_STATS_DB_PATH=data/download-stats.sqlite3
